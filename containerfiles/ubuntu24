FROM ubuntu:24.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y linux-image-generic systemd-boot dracut && \
    apt-get install -y network-manager cloud-init cloud-utils && \
    apt-get install -y openssh-server openssh-client sudo rsyslog ethtool less && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Restore full Ubuntu content (man pages, docs, etc.)
#RUN yes | unminimize

RUN systemctl enable systemd-networkd && \
    systemctl enable cloud-init && \
    systemctl enable ssh
